"""Bazel module for the ABI-bound PostgreSQL and MySQL integrations.

Scope
-----

Bazel builds `yesno-pg`, `yesno-mysql`, and the exact database servers that
load them, plus their first-party Rust dependencies. Everything else in the
workspace is built and gated by cargo, and `scripts/gate.sh` is untouched. See
`.bazelrc` for why these ABI-bound exceptions exist.

Dependency versions
-------------------

`Cargo.toml` and `Cargo.lock` remain the single source of truth for every
third-party Rust version. `crate_universe` reads them; it does not replace them.
Never hand-write a crate version into this file. A second dependency list is a
list that drifts, and the `get-size2 = 0.10.1` pin in `Cargo.lock` exists
precisely because a silent version move produced a trait error inside a
dependency. Re-pin with:

    CARGO_BAZEL_REPIN=1 bazel mod deps

Repinning is opt-in on purpose: a stale lockfile must fail the build loudly
rather than resolve to something nobody chose.
"""

module(
    name = "yesno",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# libclang, for bindgen. `pgrx-pg-sys`'s build script generates PostgreSQL's
# bindings at build time, and bindgen loads libclang at runtime through
# `clang-sys`. It is a **toolchain** dependency, not an ambient one: this
# machine has no system clang at all, and a build that silently used one if it
# were present would be reproducible only by accident.
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "17.0.6",
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# ─── Rust toolchain ──────────────────────────────────────────────────────────
#
# This does NOT verify the workspace's MSRVs and must not be mistaken for
# doing so. Workspace members promise at least 1.95 and the PostgreSQL
# extension requires 1.96. Bazel builds one configuration with one rustc, so
# the `msrv` CI job stays on cargo and checks the core package's floor.
# This toolchain is chosen to satisfy pgrx 0.19, whose MSRV is 1.96.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# ─── Third-party crates, resolved from the existing Cargo files ──────────────
# **One** extension proxy, several hubs. `use_extension` with the same
# ( file, name ) pair returns a proxy to the *same* extension instance, so
# calling it twice does not give two independent configurations — every tag
# lands on one extension and an `annotation` without `repositories` is applied
# to whichever hub happens to match, then fails as "unused" on the others.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# The cargo workspace. Only the workspace root manifest is needed; crate_universe
# reads the members from it.
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# `yesno-pg` is outside `[workspace] members` — it has its own empty
# `[workspace]` table, following the `yesno-core/fuzz` precedent — so it carries
# its own lockfile and needs its own resolution. Keeping them separate is what
# stops the pgrx and tonic trees from reaching `cargo tree -p yesno-core`, which
# the `lean-core` CI job caps at five direct dependencies.
crate.from_cargo(
    name = "crates_pg17",
    cargo_lockfile = "//yesno-pg:Cargo.lock",
    # Exactly one manifest. `crate_universe` refuses a list spanning two
    # cargo workspaces, so first-party crates from the main workspace —
    # `yesno-wire` — are wired as ordinary Bazel deps in `//yesno-pg:BUILD.bazel`
    # rather than through this hub.
    manifests = ["//yesno-pg:Cargo.toml"],
)

# Features are absent from Cargo.lock, so the PostgreSQL 18 hub can share the
# exact same authoritative resolution. The second manifest differs only in its
# default `pgN` feature; `scripts/check-pg-manifests.py` enforces that
# mechanically.
crate.from_cargo(
    name = "crates_pg18",
    cargo_lockfile = "//yesno-pg:Cargo.lock",
    manifests = ["//yesno-pg:pg18/Cargo.toml"],
)

# ─── The pgrx integration, which is the whole risk of phase 0 ────────────────
#
# `pgrx-pg-sys`'s build script does two things cargo normally arranges and Bazel
# does not: it locates a PostgreSQL install through `pg_config`, and it runs
# bindgen over that install's server headers. Both are supplied here explicitly.
#
# The `pgN` feature and the `pg_config` must name the **same major version**.
# They are wired from one flag ( `--//:pg_version` ) for exactly that reason: a
# build with `pg17` bindings against an 18 server produces a library that links
# and then corrupts the backend at runtime.
crate.annotation(
    # Not optional. Without it the annotation is offered to every hub this
    # extension defines, fails to match `crates` — which has no pgrx — and the
    # whole module graph errors with "Unused annotations were provided".
    repositories = ["crates_pg17"],
    # `@@//` and not `//`. Labels here are resolved in the **spoke** repo of
    # the annotated crate, so a bare `//third_party/…` looks for that package
    # inside `crates_pg17__pgrx-pg-sys-0.19.2` and fails. See
    # `third_party/llvm/BUILD.bazel` for why libclang is re-exported rather than
    # referenced across repositories.
    # `:libclang` appears here *and* is the target of `$(execpath)` below.
    # `$(execpath X)` requires X itself to be a declared prerequisite — naming
    # only the enclosing `:libclang_runtime` group fails with "label … in
    # $(location) expression is not a declared prerequisite of this rule".
    build_script_data = [
        "@@//third_party/llvm:libclang",
        "@@//third_party/llvm:libclang_runtime",
        "@@//third_party/postgresql:pg17_gen_dir",
        "@@//third_party/postgresql:pg17_pg_config",
    ],
    build_script_env = {
        # `pgrx-pg-sys` accepts a direct path to a `pg_config`, which is what
        # lets this skip `cargo pgrx init` and the `~/.pgrx` state entirely.
        "PGRX_PG_CONFIG_PATH": "$(execpath @@//third_party/postgresql:pg17_pg_config)",
        # `clang-sys` accepts either a directory or a path to the library
        # itself. Given a path, it uses it without searching — which is the
        # point, on a host with no system clang to fall back to.
        "LIBCLANG_PATH": "$(execpath @@//third_party/llvm:libclang)",
    },
    crate = "pgrx-pg-sys",
)

crate.annotation(
    repositories = ["crates_pg18"],
    build_script_data = [
        "@@//third_party/llvm:libclang",
        "@@//third_party/llvm:libclang_runtime",
        "@@//third_party/postgresql:pg18_gen_dir",
        "@@//third_party/postgresql:pg18_pg_config",
    ],
    build_script_env = {
        "PGRX_PG_CONFIG_PATH": "$(execpath @@//third_party/postgresql:pg18_pg_config)",
        "LIBCLANG_PATH": "$(execpath @@//third_party/llvm:libclang)",
    },
    crate = "pgrx-pg-sys",
)
use_repo(crate, "crates_pg17", "crates_pg18")

# ─── PostgreSQL, from source, pinned ─────────────────────────────────────────
#
# A `cdylib` that PostgreSQL `dlopen`s must match the server's ABI exactly, so
# the server the tests run against is built here rather than found on the host.
#
# Each archive has a matching pgrx hub above. The root `pg_version` flag selects
# the hub, this crate's feature, and these server artifacts as one configuration.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

