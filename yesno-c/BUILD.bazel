"""The host-independent C ABI as a Bazel static library.

Cargo remains the authority for the C-facing tests and the Rust 1.95 MSRV.
This target exists so ABI-bound host builds can consume the exact same Rust
sources without invoking Cargo from inside a foreign build action.
"""

load("@rules_rust//rust:defs.bzl", "rust_static_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "include/yesno.h",
])

rust_static_library(
    name = "yesno_c",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "yesno_c",
    edition = "2021",
    rustc_flags = ["-Crelocation-model=pic"],
    version = "0.1.0",
    deps = ["//yesno-core:yesno_core"],
)

filegroup(
    name = "yesno_header",
    srcs = ["include/yesno.h"],
)
